<p>
  <label for="toggle1">Standard toggle:</label>
  <OneWayToggle
    @inputId="toggle1"
    @onFocusOut={{action "toggle1FocusOut"}}
    @checked={{twoStateToggle}}
    @update={{action (mut twoStateToggle)}}
  />
    Value: {{twoStateToggle}}
</p>
<p>
  <label for="toggle2">Three-state toggle:</label>
  <OneWayToggle
    @inputId="toggle2"
    @checked={{threeStateToggle}}
    @threeState={{true}}
    @allowThreeStateToggle={{true}}
    @update={{action (mut threeStateToggle)}}
  />
    Value: {{threeStateToggle}}
</p>
<p>
  <label for="toggle3">Disabled toggle:</label>
  <OneWayToggle
    @inputId="toggle3"
    @checked={{disabledToggle}}
    @isReadOnly={{true}}
  /> Value: {{disabledToggle}}
</p>
<p>
  <label for="toggle4">Delayed toggle:</label>
  <OneWayToggle
    @inputId="toggle4"
    @checked={{delayedToggle1}}
    @update={{action "promisedToggle" "delayedToggle1"}}
  />
    Value: {{delayedToggle1}}
</p>
<p>
  <label for="toggle5">Delayed toggle (spinner on the left):</label>
  <div style="width: 60px;display: inline-block;">
    <OneWayToggle
      @inputId="toggle5"
      @checked={{delayedToggle2}}
      @spinnerSide="left"
      @update={{action "promisedToggle" "delayedToggle2"}}
      class="pull-right"
    />
  </div>
    Value: {{delayedToggle2}}
</p>
<p>
  <label for="toggle6">Toggle with tooltip:</label>
  <OneWayToggle
    @inputId="toggle6"
    @checked={{tooltipToggle}}
    @update={{action (mut tooltipToggle)}}
    @tip="Custom tooltip"
  />
    Value: {{tooltipToggle}}
</p>
<p>
  <label for="toggle7">Toggle with custom icon:</label>
  <OneWayToggle
    @inputId="toggle7"
    @checked={{iconToggle}}
    @update={{action (mut iconToggle)}}
    @icon="x"
  />
    Value: {{iconToggle}}
</p>
<p>
  <label for="toggle-danger">Three-state danger toggle:</label>
  <OneWayToggle
    @inputId="toggle-danger"
    @checked={{this.threeStateDangerToggle}}
    @threeState={{true}}
    @allowThreeStateToggle={{true}}
    @update={{action (mut this.threeStateDangerToggle)}}
    class="danger"
  />
    Value: {{this.threeStateDangerToggle}}
</p>