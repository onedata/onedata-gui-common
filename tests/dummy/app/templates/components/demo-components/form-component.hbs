<form @onsubmit={{prevent-default}} class="form form-horizontal form-component">
  <FormComponent::FieldRenderer @field={{rootFieldsGroup}} />

  {{#if isDuplicatedFieldShown}}
    <p>Duplicated second field separated from the rest:</p>
    <FormComponent::FieldRenderer @field={{rootFieldsGroup.fields.[1]}} />
  {{/if}}
</form>
{{#if isFormInfoShown}}
  <p>
    isValid: {{isFormValid}}<br/>
    lastChangedField: {{lastChangedField}}<br/>
    lastChangedValue: {{lastChangedValue}}<br/>
    values:<br/>
    <ul>
      {{#each-in this.values as |key value|}}
        <li>{{key}}:  {{value}}</li>
      {{/each-in}}
    </ul>
  </p>
{{/if}}