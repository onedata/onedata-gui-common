<div class="container">
  <h3>Large</h3>
  <div class="row row-content">
    <OneClipboardLine @value={{longText}} />
  </div>
  <h3>Small</h3>
  <div class="row row-content">
    <OneClipboardLine @size="sm" @value={{longText}} />
  </div>
  <h3>Large with label</h3>
  <div class="row row-content">
    <OneClipboardLine @label="Large:" @value={{shortText}} />
  </div>
  <h3>Small with label</h3>
  <div class="row row-content">
    <OneClipboardLine @label="Small:" @size="sm" @value={{shortText}} />
  </div>
  <h3>Textarea</h3>
  <div class="row row-content">
    <OneClipboardLine class="monospace" @type="textarea" @value={{textareaFillText}} />
  </div>
  <hr>
  <h3>Custom large with addon left</h3>
  <div class="row row-content">
    <div class="clipboard-line custom-large-clipboard">
      <div class="input-group">
        <div class="input-group-addon">
          <strong>
            Hello
            <OneTooltip @title="Test" />
          </strong>
          world
        </div>
        <input
          type="text"
          class="clipboard-input form-control"
          value="Copy me!"
          readonly
        >
      </div>
      <OneCopyButton
        class="clipboard-btn clipboard-btn-input"
        @clipboardTarget=".custom-large-clipboard input.clipboard-input"
      >
        <div class="copy-btn-background"></div>
        <OneIcon class="copy-btn-icon" @icon="browser-copy" />
      </OneCopyButton>
    </div>
  </div>
</div>
