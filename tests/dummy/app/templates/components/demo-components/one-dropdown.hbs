<div class="one-dropdown-demo-component container">
  <div class="row row-content">
    <h3>OneDropdown</h3>
    <div class="row">
      <OneDropdown
        @options={{array "one" "two" "three"}}
        @selected={{value}}
        @searchEnabled={{true}}
        @onChange={{action (mut value)}}
        as |value|
      >
        {{value}}
      </OneDropdown>
    </div>
  </div>
  <div class="row row-content">
    <h3>OneDropdown small</h3>
    <div class="row">
      <OneDropdown
        @triggerClass="small"
        @dropdownClass="small"
        @options={{array "one" "two" "three"}}
        @selected={{valueSmall}}
        @searchEnabled={{true}}
        @onChange={{action (mut valueSmall)}}
        as |value|
      >
        {{value}}
      </OneDropdown>
    </div>
  </div>
  <div class="row row-content">
    <h3>OneDropdown disabled</h3>
    <div class="row">
      <OneDropdown
        @options={{array "one" "two" "three"}}
        @selected={{value}}
        @searchEnabled={{true}}
        @onChange={{action (mut value)}}
        @disabled={{true}}
        as |value|
      >
        {{value}}
      </OneDropdown>
    </div>
  </div>
  <div class="row row-content">
    <h3>OneDropdown with groups</h3>
    <div class="row toggle-row">
      <OneWayToggle
        @checked={{areGroupsCollapsible}}
        @update={{fn (mut areGroupsCollapsible)}}
        id="collapsible-groups-toggle"
      />
      <label for="collapsible-groups-toggle">Collapsible groups</label>
    </div>
    <div class="row">
      <h4>Normal size</h4>
      <OneDropdown
        @triggerClass="some-trigger-class"
        @dropdownClass="some-dropdown-class"
        @areGroupsCollapsible={{areGroupsCollapsible}}
        @options={{optionsWithGroups}}
        @selected={{valueWithGroups}}
        @searchEnabled={{true}}
        @onChange={{action (mut valueWithGroups)}}
        as |value|
      >
        {{value}}
      </OneDropdown>
    </div>
    <div class="row">
      <h4>Small</h4>
      <OneDropdown
        @triggerClass="small"
        @dropdownClass="small"
        @areGroupsCollapsible={{areGroupsCollapsible}}
        @options={{optionsWithGroups}}
        @selected={{valueWithGroupsSmall}}
        @searchEnabled={{true}}
        @onChange={{action (mut valueWithGroupsSmall)}}
        as |value|
      >
        {{value}}
      </OneDropdown>
    </div>
  </div>
  <div class="row row-content">
    <h3>OneDropdown pseudo-text</h3>
    <div class="row">
      <p>Hello world</p>
      <div class="row">
        <div class="col-xs-4 text-with-power-select text-right">
          Text on left
        </div>
        <div class="col-xs-4">
          <OneDropdown
            @triggerClass="small text-like"
            @dropdownClass="small"
            @options={{array "very long text very" "two" "three"}}
            @selected={{valueSmallText}}
            @onChange={{action (mut valueSmallText)}}
            as |value|
          >
            {{value}}
          </OneDropdown>
        </div>
        <div class="col-xs-4 text-with-power-select">
          Some text on right
        </div>
      </div>
      <p>Foo bar</p>
    </div>
  </div>
  <div class="row row-content">
    <h3>OneDropdown many items</h3>
    <div class="row">
      <OneDropdown
        @options={{manyOptions}}
        @selected={{value}}
        @searchEnabled={{true}}
        @onChange={{action (mut value)}}
        as |value|
      >
        {{value}}
      </OneDropdown>
    </div>
  </div>
</div>