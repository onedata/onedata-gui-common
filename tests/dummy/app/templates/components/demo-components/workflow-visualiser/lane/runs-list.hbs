<div class="workflow-visualiser">
  <WorkflowVisualiser::Lane::RunsList
    @runsRegistry={{runsRegistry}}
    @selectedRunNumber={{selectedRunNumber}}
    @visibleRunsPosition={{visibleRunsPosition}}
