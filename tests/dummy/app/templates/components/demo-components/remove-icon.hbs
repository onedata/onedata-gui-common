<h1>remove-icon</h1>
<p>
  Simple:
  <RemoveIcon @onClick={{action "click"}} />
</p>
<p>
  With tooltip:
  <RemoveIcon @onClick={{action "click"}} @tooltipText="Remove it!" />
</p>
<p>
  Disabled:
  <RemoveIcon
    @isDisabled={{true}}
    @onClick={{action "click"}}
    @tooltipText="Remove it!"
  />
</p>
