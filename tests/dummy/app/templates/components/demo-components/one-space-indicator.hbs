<h1>Standard</h1>
<div style="max-width: 500px">
  Small:
  <OneSpaceIndicator
    @currentTotalSize={{smallCurrentTotalSize}}
    @occupiedSize={{smallOccupiedSize}}
  />

  Medium:
  <OneSpaceIndicator
    @currentTotalSize={{mediumCurrentTotalSize}}
    @occupiedSize={{mediumOccupiedSize}}
  />

  Large:
  <OneSpaceIndicator
    @currentTotalSize={{largeCurrentTotalSize}}
    @occupiedSize={{largeOccupiedSize}}
  />

  Too large:
  <OneSpaceIndicator
    @currentTotalSize={{tooLargeCurrentTotalSize}}
    @occupiedSize={{tooLargeOccupiedSize}}
  />
</div>
<h1>State after change</h1>
<div style="max-width: 500px">
  Expanding only a little:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{50}}
    @newTotalSize={{102}}
  />
  
  Expanding more:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{50}}
    @newTotalSize={{150}}
  />

  Expanding when the space is almost full:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{99}}
    @newTotalSize={{120}}
  />
  
  Expanding when data already exceeds space:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{150}}
    @newTotalSize={{160}}
  />
  
  Shrinking only a little:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{50}}
    @newTotalSize={{98}}
  />
  
  Shrinking more:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{50}}
    @newTotalSize={{80}}
  />
  
  Shrinking causes space warning:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{50}}
    @newTotalSize={{52}}
  />
  
  Shrinking below data usage:
  <OneSpaceIndicator
    @currentTotalSize={{100}}
    @occupiedSize={{50}}
    @newTotalSize={{30}}
  />
</div>
<h1>Other/errors</h1>
<div style="max-width: 500px">
  newTotalSize below 0:
  <OneSpaceIndicator
    @currentTotalSize={{20}}
    @occupiedSize={{10}}
    @newTotalSize={{-10}}
  />
  
  undefined occupiedSize:
  <OneSpaceIndicator @currentTotalSize={{100}} @occupiedSize={{undefined}} />
  
  currentTotalSize below 0:
  <OneSpaceIndicator @currentTotalSize={{-5}} @occupiedSize={{10}} />
</div>