<div style="height: 500px">
  <OneAtlas as |atlas|>
    <atlas.position
      @latitude={{provider.latitude}}
      @longitude={{provider.longitude}}
      as |position|
    >
      <position.point>
        <ProviderPlace
          @provider={{provider}}
          @atlasWidth={{atlas.width}}
          @circleSizeScale={{4}}
        />
      </position.point>
    </atlas.position>
  </OneAtlas>
</div>
