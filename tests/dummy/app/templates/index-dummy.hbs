<LinkTo
  @route="index-dummy.readme"
>Readme</LinkTo>
<div class="row">
  <ul class="col-sm-3">
    <li>Components
      <ul>
        {{#each model.components as |componentName|}}
          <li>
            <LinkTo
              @route="index-dummy.component"
              @model={{componentName}}
            >{{componentName}}</LinkTo>
          </li>
        {{/each}}
      </ul>
    </li>
  </ul>
  <div class="col-sm-9 col-content">
    {{outlet}}
  </div>
</div>
