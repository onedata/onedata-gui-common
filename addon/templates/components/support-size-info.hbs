<div class="row content-row component-header-row no-border">
  <strong>{{header}}</strong>
  {{#if (and (not dataError) totalSize)}}
    <div class="support-size">
      ({{tt this "total"}} {{bytes-to-string totalSize}})
    </div>
  {{/if}}
  {{#if _tipVisible}}
    <OneLabelTip
      @title={{if (eq mode "chart") chartHeaderTip tableHeaderTip}}
      @placement="top"
    />
  {{/if}}
  {{#if data.length}}
    <BsButtonGroup
      @value={{mode}}
      @type="radio"
      @onChange={{action "modeChanged"}}
      as |bg|
    >
      <bg.button
        @type="default"
        class="btn-sm chart-mode"
        @value="chart"
        disabled={{disabledChartMode}}
      >
        {{tt this "mode.chart"}}
        {{#if disabledChartMode}}
          <OneTooltip @title={{tt this "chartDisabledTooltip"}} />
        {{/if}}
      </bg.button>
      <bg.button @type="default" class="btn-sm table-mode" @value="table">
        {{tt this "mode.table"}}
      </bg.button>
    </BsButtonGroup>
  {{/if}}
</div>
{{#if (not dataError)}}
  {{#if (or (eq mode "table") (eq data.length 0))}}
    <div
      class="form-group form-group-sm form-group-light search-group"
    >
      <div class="input-group with-icon-addon">
        <SearchBar @search={{action (mut searchString)}} class="form-control" />
        <div class="input-group-addon">
          <OneIcon @icon="search" />
        </div>
      </div>
    </div>
    <div class="row content-row">
      <SupportSizeInfo::Table
        @data={{filteredSupportTableData}}
        @supporterNameHeader={{supporterNameHeader}}
        @noDataToShowMessage={{noDataToShowMessage}}
        @type={{type}}
      />
    </div>
  {{else}}
    <div class="row chart-row content-row">
      <SupportSizeInfo::Chart @data={{data}} @sort={{true}} />
    </div>
  {{/if}}
{{else}}
  <div class="row content row">
    <ResourceLoadError @reason={{dataError}} />
  </div>
{{/if}}
