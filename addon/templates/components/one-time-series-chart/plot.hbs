<PromiseProxyContainer @proxy={{stateProxy}} @sizeClass="sm">
  <div class="canvas-area">
    {{#if hasDataToShow}}
      <OneEchart @option={{echartState}} @registerApi={{action "registerApi"}} />
    {{else}}
      <div class="no-data-message">
        <div class="no-data-img"></div>
        {{tt this "noDataToShow"}}
      </div>
    {{/if}}
  </div>
  {{#if title}}
    <div class="title-area">
      <TruncatedString class="title-content">
        {{title}}
      </TruncatedString>
      {{#if titleTip}}
        <span class="space"></span>
        <OneLabelTip class="title-tip" @title={{titleTip}} />
      {{/if}}
    </div>
  {{/if}}
</PromiseProxyContainer>
