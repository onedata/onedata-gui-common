<GlobalModal
  @classNames={{concat-classes "question-modal" modalClassName}}
  @allowClose={{not isSubmitting}}
  @modalId={{modalId}}
  @shouldCloseOnTransition={{shouldCloseOnTransition}}
  as |modal|
>

  <modal.header>
    <h1>
      {{#if headerIcon}}
        <OneIcon @icon={{headerIcon}} />
      {{/if}}
      <span class="one-label">{{headerText}}</span>
    </h1>
  </modal.header>

  <modal.body>
    {{#each descriptionParagraphs as |paragraph|}}
      <p class={{paragraph.className}}>{{paragraph.text}}</p>
    {{/each}}
    {{#if isCheckboxVisible}}
      <div class="row content-row no-border row-understand-notice">
        <OneCheckbox
          class="danger one-checkbox-danger one-checkbox-understand"
          @checked={{isCheckboxChecked}}
          @update={{action (mut isCheckboxChecked)}}
        />
        <div
          class="text-understand clickable"
          {{action (mut isCheckboxChecked) (not isCheckboxChecked)}}
        >
          {{checkboxMessage}}
        </div>
      </div>
    {{/if}}
  </modal.body>

  <modal.footer class="btn-toolbar">
    {{#unless isNoButtonHidden}}
      <OneButton
        @type="default"
        class="question-no"
        @onClick={{modal.close}}
        @disabled={{isSubmitting}}
      >
        {{noButtonText}}
      </OneButton>
    {{/unless}}
    {{#unless isYesButtonHidden}}
      <OneButton
        @type={{yesButtonType}}
        @buttonType="submit"
        class="question-yes"
        @onClick={{action "submit" modal.submit}}
        @disabled={{isYesButtonDisabled}}
      >
        {{yesButtonText}}
      </OneButton>
    {{/unless}}
  </modal.footer>

</GlobalModal>