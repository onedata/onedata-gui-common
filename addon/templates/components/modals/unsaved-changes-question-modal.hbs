<GlobalModal
  @classNames="unsaved-changes-question-modal"
  @allowClose={{not isSubmitting}}
  @modalId={{modalId}} as |modal|
>

  <modal.header>
    <h1>
      <OneIcon @icon="sign-warning-rounded" />
      <span class="one-label">{{tt this "header"}}</span>
    </h1>
  </modal.header>

  <modal.body>
    <p class="disclaimer text-danger">{{tt this "body.disclaimer"}}</p>
  </modal.body>

  <modal.footer class="btn-toolbar">
    <OneButton
      class="question-dont-save pull-left no-left-margin"
      @onClick={{action "submit" modal.submit false}}
      @disabled={{isSubmitting}}
    >
      {{tt this "button.dontSave"}}
    </OneButton>
    <OneButton
      @type="default"
      class="question-cancel"
      @onClick={{modal.close}}
      @disabled={{isSubmitting}}
    >
      {{tt this "button.cancel"}}
    </OneButton>
    <span class="btn-tooltip-container">
      <OneButton
        @type="primary"
        @buttonType="submit"
        class="question-save"
        @onClick={{action "submit" modal.submit true}}
        @disabled={{or isSubmitting saveDisabledReason}}
      >
        {{tt this "button.save"}}
      </OneButton>
      {{#if saveDisabledReason}}
        <OneTooltip @title={{saveDisabledReason}} />
      {{/if}}
    </span>
  </modal.footer>

</GlobalModal>
