<GlobalModal
  @classNames="lane-modal"
  @allowClose={{not isSubmitting}}
  @modalId={{modalId}}
  as |modal|
>

  <modal.header>
    <h1>{{headerText}}</h1>
    {{#if lane.name}}
      <h2 class="normal-case">
        <TruncatedString class="header-content">
            <div class="inline-icon-container header-icon">
              <OneIcon @icon="atm-lane" />
            </div>
          {{lane.name}}
        </TruncatedString>
      </h2>
    {{/if}}
  </modal.header>

  <modal.body>
    <Modals::WorkflowVisualiser::LaneModal::LaneForm
      @mode={{mode}}
      @lane={{lane}}
      @definedStores={{definedStores}}
      @createStoreAction={{createStoreAction}}
      @onChange={{action "formChange"}}
      @isDisabled={{isSubmitting}}
    />
  </modal.body>

  <modal.footer class="btn-toolbar">
    <OneButton
      @type="default"
      class="btn-cancel"
      @onClick={{modal.close}}
      @disabled={{isSubmitting}}
    >
      {{cancelBtnText}}
    </OneButton>
    {{#if (not-eq mode "view")}}
      <OneButton
        @type="primary"
        @buttonType="submit"
        class="btn-submit"
        @onClick={{action "submit" modal.submit}}
        @disabled={{not formIsValid}}
      >
        {{submitBtnText}}
      </OneButton>
    {{/if}}
  </modal.footer>

</GlobalModal>
