<PromiseProxyContainer @proxy={{valueContainerProxy}}>
  {{#if (eq valueContainerProxy.content null)}}
    <div class="alert alert-warning">
      {{emptyStoreText}}
    </div>
  {{else}}
    <Modals::WorkflowVisualiser::StoreModal::ValueContainerPresenter
      @dataSpec={{dataSpec}}
      @valueContainer={{valueContainerProxy.content}}
      @context={{context}}
    />
  {{/if}}
</PromiseProxyContainer>
