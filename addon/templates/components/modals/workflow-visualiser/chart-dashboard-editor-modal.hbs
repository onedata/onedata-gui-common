{{!-- TODO: VFS-10331 unify modal layout in zone and provider --}}
<GlobalModal
  @classNames={{concat-classes
    "chart-dashboard-editor-modal"
    (concat "mode-" mode)
    (if (eq mode "view")
    "without-footer modal-content-overlay with-close-button")
  }}
  @allowClose={{isReadOnly}}
  @modalId={{modalId}}
  @size="full"
  as |modal|
>
  <modal.header>
    <h1>{{tt this (concat "header." dashboardOwnerType)}}</h1>
    {{#if dashboardOwner.name}}
      <h2 class="normal-case">
        <TruncatedString class="header-content">
          {{#if dashboardOwner.icon}}
            <div class="inline-icon-container header-icon">
              <OneIcon @icon={{dashboardOwner.icon}} />
            </div>
          {{/if}}
          {{dashboardOwner.name}}
        </TruncatedString>
      </h2>
    {{/if}}
  </modal.header>

  <modal.body>
    <AtmWorkflow::ChartDashboardEditor
      @dashboardModel={{dashboardModel}}
      @isReadOnly={{eq mode "view"}}
    />
  </modal.body>

  {{#if (not-eq mode "view")}}
    <modal.footer class="btn-toolbar">
      {{#if isModelChanged}}
        <OneButton
          @type="warning"
          class="btn-cancel"
          @onClick={{action "cancel" modal.close}}
          @disabled={{isSubmitting}}
        >
          {{tt this (concat "buttons.cancel")}}
        </OneButton>

        <OneButton
          @type="primary"
          @buttonType="submit"
          class="btn-submit"
          @onClick={{action "submit" modal.submit}}
        >
          {{tt this "buttons.submit"}}
        </OneButton>
      {{else}}
        <OneButton
          @type="default"
          class="btn-close"
          @onClick={{modal.close}}
        >
          {{tt this "buttons.close"}}
        </OneButton>
      {{/if}}
    </modal.footer>
  {{/if}}

</GlobalModal>
