<GlobalModal
  @classNames="record-selector-modal"
  @allowClose={{not this.isSubmitting}}
  @modalId={{this.modalId}} as |modal|
>

  <modal.header>
    <h1>{{this.headerText}}</h1>
  </modal.header>

  <modal.body>
    <p class="description">{{this.descriptionText}}</p>
    <div class={{concat-classes
      "dropdown-container"
      (if this.recordOptionsProxy.isPending "loading")
      (if this.loadingText "with-loading-label")
    }}>
      <PromiseProxyContainer
        @proxy={{this.recordOptionsProxy}}
        @sizeClass="sm"
        @loadingLabel={{this.loadingText}}
      >
        <OneDropdown
          @options={{this.recordOptionsProxy.content.content}}
          @onChange={{action (mut this.selectedRecordOption)}}
          @selected={{this.selectedRecordOption}}
          @placeholder={{this.selectorPlaceholderText}}
          @searchEnabled={{true}}
          as |recordOption|
        >
          <div class="option-container">
            <OneIcon @icon={{recordOption.icon}} />
            <TruncatedString class="text">
              {{recordOption.label}}
            </TruncatedString>
          </div>
        </OneDropdown>
      </PromiseProxyContainer>
    </div>
  </modal.body>

  <modal.footer class="btn-toolbar">
    <OneButton
      @type="default"
      class="record-selector-cancel"
      @onClick={{modal.close}}
      @disabled={{this.isSubmitting}}
    >
      {{tt this "cancel"}}
    </OneButton>
    <OneButton
      @type="primary"
      @buttonType="submit"
      class="record-selector-submit"
      @onClick={{action "submit" modal.submit}}
      @disabled={{not this.selectedRecordOption}}
    >
      {{this.submitText}}
    </OneButton>
  </modal.footer>

</GlobalModal>
