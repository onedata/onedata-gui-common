{{#if (and _outerTextPresent (eq outerTextSide "left"))}}
  <div class="outer-text">{{outerText}}</div>
{{/if}}
<OneIcon @icon={{icon}} class="one-icon-status">
  {{#if _innerTextPresent}}
    <div class="inner-text">{{innerText}}</div>
  {{/if}}
</OneIcon>{{#if (and _outerTextPresent (eq outerTextSide "right"))}}<div class="outer-text">{{outerText}}</div>{{/if}}
{{#if subIcon}}
  <OneIcon class={{concat-classes "sub-status-icon" subIconClass}} @icon={{subIcon}} />
{{/if}}
{{#if (and enabled hint)}}
  <OneTooltip @title={{hint}} @placement="top" />
{{/if}}
