<div class="one-pill-button-inner">
  <div class="button-text">
    {{yield}}
  </div>
  <div
    class="one-pill-button-actions-trigger"
    onclick={{action (disable-bubbling (action "toggleActions"))}}
  >
    {{#if useDots}}
      <div class="icon-dot"></div>
      <div class="icon-dot"></div>
      <div class="icon-dot"></div>
    {{else}}
      <OneIcon @icon={{arrowIcon}} />
    {{/if}}
  </div>
  <OneWebuiPopover
    class="one-pill-button-actions-popover"
    @popoverStyle={{concat-classes "with-dropdown" popoverClass}}
    @padding={{false}}
    @popoverTrigger="manual"
    @triggerSelector={{concat "#" elementId " .one-pill-button-actions-trigger"}}
    @open={{actionsOpen}}
    as |popover|
  >
    <ClickOutside @onClickOutside={{action "toggleActions" false}}>
      <PopoverContentLimit @opened={{popover.visible}}>
        <ActionsPopoverContent
          @actionsArray={{menuItems}}
          @actionClicked={{action "toggleActions" false}}
          class="button-actions ps--focus"
        />
      </PopoverContentLimit>
    </ClickOutside>
  </OneWebuiPopover>

</div>
