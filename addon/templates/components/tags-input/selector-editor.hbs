<OneWebuiPopover
  class="tags-selector"
  @open={{true}}
  @triggerSelector={{concat "#" elementId}}
  @arrow={{false}}
  @registerApi={{action (mut popoverApi)}}
  @padding={{false}}
  @placement="vertical"
  @popoverStyle="tags-selector"
  as |popover|
>
  <PerfectScrollbarElement>
    <ClickOutside
      @onClickOutside={{onEndTagCreation}}
      @exceptSelector={{parentTagsInputSelector}}
    >
      <ul class="selector-list">
        {{#each tagsToSelect as |tag|}}
          <li class="selector-item" onClick={{action "tagSelected" tag}}>
            {{#if tag.icon}}
              <OneIcon @icon={{tag.icon}} class="tag-icon" />
            {{/if}}
            <TruncatedString class="tag-label">{{tag.label}}</TruncatedString>
          </li>
        {{/each}}
      </ul>
    </ClickOutside>
  </PerfectScrollbarElement>
</OneWebuiPopover>
{{yield}}
