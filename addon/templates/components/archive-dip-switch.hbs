<BsButtonGroup
  class={{concat-classes
    class
    "dip-switch archive-dip-switch"
    (if disabled "disabled")
  }}
  @value={{archiveDipMode}}
  @type="radio"
  @onChange={{action onArchiveDipModeChange}}
  as |bg|
>
  <div class="btn-group" role="group">
    <bg.button
      class="btn-sm select-archive-aip-btn"
      disabled={{disabled}}
      @type="default"
      @value="aip"
    >
      {{tt this "aip"}}
    </bg.button>
  </div>
  <div class="btn-group" role="group">
    <bg.button
      class="btn-sm select-archive-dip-btn"
      disabled={{disabled}}
      @type="default"
      @value="dip"
    >
      {{tt this "dip"}}
    </bg.button>
  </div>
  {{#if disabled}}
    <OneTooltip @title={{tt this "disabledTip"}} />
  {{/if}}
</BsButtonGroup>
