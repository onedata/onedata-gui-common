<div class="oneproviders-list-title">{{tt this "oneproviders"}}</div>
<div class="form-group-sm form-group-light search-group">
  <div class="input-group with-icon-addon">
    <SearchBar @search={{action "queryChanged"}} class="form-control" />
    <div class="input-group-addon">
      <OneIcon @icon="search" />
    </div>
  </div>
</div>
<PerfectScrollbarElement @tagName="ul" class="oneproviders-list">
  {{#each filteredOneproviders as |oneprovider|}}
    <li
      class="oneproviders-list-item {{if (eq oneprovider selectedOneprovider) "active"}}"
      data-provider={{oneprovider.id}}
      {{action onOneproviderSelected oneprovider}}>
      <OneIcon
        @icon="provider"
        class={{if oneprovider.online "online-icon" "offline-icon"}}
      />
      <TruncatedString><NameConflict
        @item={{oneprovider}}
        @tagName="span"
      /></TruncatedString>
    </li>
  {{/each}}
</PerfectScrollbarElement>
