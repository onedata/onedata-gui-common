{{#if label}}
  <div class="clipboard-line-label">
    <strong>{{label}}</strong>
  </div>
{{/if}}

{{#if (eq type "textarea")}}
  <textarea
    rows="{{textareaRows}}"
    class="clipboard-input form-control {{inputClass}}"
    readonly
  >{{value}}</textarea>
{{else if (eq type "html")}}
  <div class="clipboard-input">
    <div class="form-control form-control-block">
      <div class="html-content-container">
        {{#if hasBlock}}
          {{yield}}
        {{else}}
          {{{value}}}
        {{/if}}
      </div>
    </div>
  </div>
{{else if (eq type "text")}}
  {{!-- do not break that line, to avoid copying value with whitespace characters --}}
  <div class="clipboard-input"><TruncatedString>{{value}}</TruncatedString></div>
{{else}}
  <span class="clipboard-container">
    <input
      type="text"
      class="clipboard-input form-control {{inputClass}} {{if size (concat "input-" size)}}"
      value={{value}}
      readonly
    >
    {{#if enableValueTip}}
      <OneTooltip class="string-path-tooltip" @title={{value}} />
    {{/if}}
  </span>
{{/if}}
{{#if isHiddenInputRendered}}
  <input class="hidden-clipboard-source" value={{if rawValue rawValue value}} readonly>
{{/if}}
<OneCopyButton
  class={{concat-classes "clipboard-btn" clipboardBtnClass}}
  @parentElementId={{elementId}}
  @localTarget={{if isHiddenInputRendered ".hidden-clipboard-source" ".clipboard-input"}}
  @notify={{action "notify"}}
>
  <div class="copy-btn-background"></div>
  <OneIcon class="copy-btn-icon" @icon="browser-copy" />
  <OneTooltip @title={{or buttonTip (tt this "copyHint")}} />
</OneCopyButton>
