<PerfectScrollbarElement
  @tagName="div"
  class="main-menu-content"
  @onScroll={{action "scrollOccurred"}}
  @suppressScrollX={{true}}
>
  <div class="row row-onedata-logo full-width">
    <a class="onedata-logo" href={{logoLink.content}} target="_blank">
      <OneAnimatedLogo @opened={{isExpanded}} />
    </a>
  </div>
  <div class="row row-main-menu full-width">
    <MainMenu
      @items={{reject-by "stickyBottom" mainMenuItems}}
      @itemClicked={{action "mainMenuItemClicked"}}
    />
  </div>
</PerfectScrollbarElement>
<div class="row row-account-button">
  <div class="powered-by-container">
    <div class="powered-by-inner">
      {{tt this "poweredBy"}}
      <a
        class="powered-by-onedata-link white"
        href="https://onedata.org"
        target="_blank"
      >
        {{tt this "onedata"}}
      </a>
    </div>
  </div>
  <div class="groove-border"></div>
  <MainMenu
    @items={{filter-by "stickyBottom" mainMenuItems}}
    @itemClicked={{action "mainMenuItemClicked"}}
  />
  <UserAccountButton
    @isActive={{eq navigationState.activeResourceType "users"}}
    @onMenuOpened={{action "userAccountPopoverOpened"}}
  />
</div>
