<BsForm @submitOnEnter={{false}} class={{_formClasses}} as |form|>
  <OneFormFields
    @bsForm={{form}}
    @fields={{currentFields}}
    @formValues={{formValues}}
    @inputChanged={{action "inputChanged"}}
    @onFocusOut={{action "focusOut"}}
    @disabled={{_disabled}}
  />

  {{#if submitButton}}
    <div class="row">
      <div class={{layoutConfig.formSubmitColumns}}>
        <OneButton
          @type="primary"
          @buttonType="submit"
          @onClick={{action "submit"}}
          @disabled={{not _submitEnabled}}
        >
          {{submitText}}
        </OneButton>
      </div>
    </div>
  {{/if}}
</BsForm>
