<h1>
  <span class="one-label">
    {{tt this "title"}}
  </span>
</h1>
<table class="table table-condensed table-info">
  <tbody>
    <tr class="row-with-text">
      <td class="property-name">{{tt this "name"}}</td>
      <td class="property-value">
        <OneClipboardLine
          @size="sm"
          @value={{record.name}}
          @rawValue={{record.name}}
          @type="text"
        />
      </td>
    </tr>
    <tr class="row-with-text">
      <td class="property-name">{{tt this "id"}}</td>
      <td class="property-value">
        <OneClipboardLine
          @size="sm"
          @value={{record.entityId}}
          @rawValue={{record.entityId}}
          @type="text"
        />
      </td>
    </tr>
  </tbody>
</table>
{{#if (and showDetails linkToAtmInventory)}}
  <div class="links-container">
    <a href={{linkToAtmInventory}} class="info-link clickable">
      {{tt this "openAtmInventory"}}
      <OneIcon @icon="link-external" />
    </a>
  </div>
{{/if}}
