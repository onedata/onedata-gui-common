<div
  class={{concat-classes
    "icon-container"
    (if isHovered "info-icon-container-hovered")
    (if suppressFlipping "not-animation" "animation")
  }}
>
  {{#if iconTag}}
    <OneIconTagged
      class={{concat-classes "tag-right flippable-front" iconTaggedClass}}
      @icon={{iconName}}
      @iconClass={{iconClass}}
      @tagIcon={{iconTag}}
      @shadowType={{shadowType}}
    >
      {{#if iconTip}}
        <OneTooltip @title={{iconTip}} />
      {{/if}}
    </OneIconTagged>
  {{else}}
    <OneIcon
      @icon={{iconName}}
      class={{concat-classes "flippable-front" iconClass}}
      @color={{iconColor}}
    />
    {{#if iconTip}}
      <OneTooltip @title={{iconTip}} />
    {{/if}}
  {{/if}}
  <OneIcon @icon={{backIconName}} class="flippable-back" />
</div>
