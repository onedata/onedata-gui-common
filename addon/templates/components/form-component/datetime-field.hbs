{{#if isInViewMode}}
  {{moment-format value viewModeFormat}}
{{else}}
  <OneDatetimePicker
    @disabled={{not isEffectivelyEnabled}}
    @value={{value}}
    @elementId={{fieldId}}
    class="form-control"
    @onChange={{action "valueChanged"}}
    @focusOut={{action "focusLost"}}
  />
{{/if}}
{{yield}}
