{{#if this.isInViewMode}}
  {{#if this.selectedOption.icon}}<OneIcon
    @icon={{this.selectedOption.icon}}
  />{{/if}}<span class="text">{{this.selectedOption.label}}</span>
{{else}}
  <AdaptiveDropdown
    @tagName="div"
    @disabled={{not this.isEffectivelyEnabled}}
    @options={{this.preparedOptions}}
    @onChange={{action "valueChanged"}}
    @selected={{this.selectedOption}}
    @placeholder={{this.placeholder}}
    @renderInPlace={{false}}
    @onBlur={{action "triggerFocusLost"}}
    @onClose={{action "focusLost"}}
    @triggerId={{this.fieldId}}
    @searchEnabled={{this.showSearch}}
    @matcher={{this.matchDropdownOption}}
    @triggerClass={{concat-classes
      "dropdown-field-trigger"
      (if (eq this.size "sm") "small")
    }}
    @dropdownClass={{concat-classes
      "dropdown-field-dropdown"
      (concat this.field.name "-field-dropdown")
      (if (eq this.size "sm") "small")
    }}
    as |option|
  >
    <div class="option-container option-{{option.name}}">
      {{#if option.icon}}
        <OneIcon @icon={{option.icon}} />
      {{/if}}
      <TruncatedString class="text">
        {{#if this.useRecordLabel}}
          <NameConflict @item={{option.value}} />
        {{else}}
          {{option.label}}
        {{/if}}
      </TruncatedString>
    </div>
  </AdaptiveDropdown>
{{/if}}
{{yield}}
