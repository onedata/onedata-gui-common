{{#if isInViewMode}}
  {{#if selectedOption.icon}}<OneIcon
    @icon={{selectedOption.icon}}
  />{{/if}}<span class="text">{{selectedOption.label}}</span>
{{else}}
  <OneDropdown
    @tagName="div"
    @disabled={{not isEffectivelyEnabled}}
    @options={{preparedOptions}}
    @onChange={{action "valueChanged"}}
    @selected={{selectedOption}}
    @placeholder={{placeholder}}
    @renderInPlace={{false}}
    @onBlur={{action "triggerFocusLost"}}
    @onClose={{action "focusLost"}}
    @triggerId={{fieldId}}
    @searchEnabled={{showSearch}}
    @matcher={{matchDropdownOption}}
    @triggerClass={{concat-classes
      "dropdown-field-trigger"
      (if (eq size "sm") "small")
    }}
    @dropdownClass={{concat-classes
      "dropdown-field-dropdown"
      (concat field.name "-field-dropdown")
      (if (eq size "sm") "small")
    }}
    as |option|
  >
    <div class="option-container option-{{option.name}}">
      {{#if option.icon}}
        <OneIcon @icon={{option.icon}} />
      {{/if}}
      <TruncatedString class="text">
      {{#if option.value.conflictLabel}}
        <NameConflict @item={{option.value}} />
      {{else}}
        {{option.label}}
      {{/if}}
      </TruncatedString>
    </div>
  </OneDropdown>
{{/if}}
{{yield}}
