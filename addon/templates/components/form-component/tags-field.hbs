<TagsInput
  @disabled={{not isEffectivelyEnabled}}
  @isReadOnly={{isInViewMode}}
  @tags={{tags}}
  @onChange={{action "valueChanged"}}
  @onFocusLost={{action "focusLost"}}
  @elementId={{fieldId}}
  @tagEditorComponentName={{tagEditorComponentName}}
  @tagEditorSettings={{tagEditorSettings}}
  @isClearButtonVisible={{isClearButtonVisible}}
  @tagsLimit={{tagsLimit}}
/>
{{yield}}
