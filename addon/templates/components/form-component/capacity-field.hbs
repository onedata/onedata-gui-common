{{#if isInViewMode}}
  {{bytes-to-string value}}
{{else}}
  <OneWayCapacity
    @value={{value}}
    @allowedUnits={{allowedUnits}}
    @inputId={{fieldId}}
    @disabled={{not isEffectivelyEnabled}}
    @placeholder={{placeholder}}
    @onChange={{action "valueChanged"}}
    @onFocusOut={{action "focusLost"}}
  />
{{/if}}
