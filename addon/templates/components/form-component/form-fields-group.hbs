{{#if title}}
  {{#if isInViewMode}}
    <div class="form-view-section-title">{{title}}:</div>
  {{else}}
    <h2 class="form-section-title">{{title}}</h2>
  {{/if}}
{{/if}}
<OneCollapse
  class={{concat-classes "fields-group-collapse" (concat name "-collapse")}}
  @collapsed={{not isExpanded}}
>
  <div class="fields-group-children {{concat name "-children"}}">
    {{#each nestedFields as |nestedField|}}
      {{#if (and
        nestedField.isVisible
        nestedField.fieldComponentName
        (or (not nestedField.isInViewMode) (not-eq nestedField.isExpanded false))
      )}}
        <FormComponent::FieldRenderer @field={{nestedField}} />
      {{/if}}
    {{/each}}
  </div>
</OneCollapse>
