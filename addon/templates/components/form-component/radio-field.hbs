{{#if isInViewMode}}
  {{get (find-by "value" value preparedOptions) "label"}}
{{else}}
  <OneWayRadioGroup
    class={{inputClasses}}
    @inputId={{fieldId}}
    @isReadOnly={{not isEffectivelyEnabled}}
    @value={{value}}
    @options={{preparedOptions}}
    @update={{action "valueChanged"}}
    @onFocusOut={{action "focusLost"}}
    @lockHint={{lockHint}}
  />
  {{#if this.hasAdditionalButton}}
    <OneButton
      @type="warning"
      @size="sm"
      @onClick={{action "additionalButtonAction"}}
    >
      <OneIcon @icon={{this.additionalButtonIcon}} />
      {{this.additionalButtonName}}
      {{#if this.additionalButtonTooltip}}
         <OneTooltip @title={{this.additionalButtonTooltip}} @triggerEvents="hover"/>
      {{/if}}
    </OneButton>
  {{/if}}
{{/if}}
{{yield}}
