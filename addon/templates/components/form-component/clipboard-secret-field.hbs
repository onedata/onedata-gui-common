{{#if this.isSecretShown}}
  <OneClipboardLine
    @value={{this.secret}}
    @type="textarea"
    @textareaRows={{this.textareaRows}}
  />
{{else}}
  <OneClipboardLine
    @value={{this.displayedText}}
    @rawValue={{this.secret}}
    @type="input"
  />
{{/if}}
<div class="show-hide-secret-btn">
  <div class="show-hide-secret-btn-background"></div>
  <OneIcon
    @icon={{if this.isSecretShown "no-view" "view"}}
    onclick={{action "toggleSecretShow"}}
    class="show-hide-secret-icon"
  >
    <OneTooltip @title={{tt this (if this.isSecretShown "hideValue" "showValue")}} />
  </OneIcon>
</div>
{{yield}}
