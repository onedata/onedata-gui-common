
{{#if this.isSecretShow}}
  <OneClipboardLine
    @value={{this.secret}}
    @type="textarea"
    @textareaRows={{this.textareaRows}}
  />
{{else}}
  <OneClipboardLine
    @value={{this.displayedText}}
    @rawValue={{this.secret}}
    @type="input"
  />
{{/if}}
<OneIcon
  @icon={{if this.isSecretShow "no-view" "view"}}
  onclick={{action "toggleSecretShow"}}
  class="show-hide-secret-icon"
>
  <OneTooltip @title={{tt this (if this.isSecretShow "hideValue" "showValue")}} />
</OneIcon>
{{yield}}
