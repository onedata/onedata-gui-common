<RenderLater @triggerRender={{isOpened}}>
  <OneWebuiPopover
    class="remove-ack-popover"
    @triggerSelector={{triggerSelector}}
    @open={{isOpened}}
    as |popover|
  >
    <ClickOutside @onClickOutside={{action "close"}} @exceptSelector={{triggerSelector}}>
      <p>{{question}}</p>
      <div class="buttons-container">
        <OneButton
          class="btn-cancel"
          @size="sm"
          @type="default"
          @onClick={{action "close"}}
        >
          {{tt this "no"}}
        </OneButton>
        <OneButton
          class="btn-confirm"
          @size="sm"
          @type="danger"
          @onClick={{action "confirm"}}
        >
          {{tt this "yes"}}
        </OneButton>
      </div>
    </ClickOutside>
  </OneWebuiPopover>
</RenderLater>
