<ul class="one-list text-center">
  <li class="one-list-item">
    <div class="row">
      <div class="col-xs-12">
        <p>{{noResourcesTranslation}}</p>
      </div>
    </div>
    {{#if showGetStarted}}
      <div class="row">
        <div class="col-xs-12">
          <LinkTo
            @route="onedata.sidebar.content"
            @models={{array resourceType "empty"}}
            class="btn btn-default hide-sm-active"
          >
            {{tt this "getStarted"}}
          </LinkTo>
        </div>
      </div>
    {{/if}}
  </li>
</ul>
