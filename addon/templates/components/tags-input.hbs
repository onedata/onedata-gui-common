{{#each displayedTags as |tag|}}
  <li class={{concat-classes
    "tag-item input-element"
    (if (contains tag currentTagsToHighlight) "animated fadeIn")
    tag.className
  }}>
    {{#if tag.icon}}
      <OneIcon @icon={{tag.icon}} class="tag-icon" />
    {{/if}}
    <TruncatedString class="tag-label">{{tag.label}}</TruncatedString>
    {{#if allowModification}}
      <OneIcon @icon="close" class="tag-remove" onclick={{action "removeTag" tag}} />
    {{/if}}
    {{#if tag.tip}}
      <OneTooltip @title={{tag.tip}} />
    {{/if}}
  </li>
{{/each}}
{{#if isCreatingTag}}
  <li class="tag-creator">
    {{#let (component this.tagEditorComponentName) as |tagEditorComponent|}}
      <tagEditorComponent
        class="input-element"
        @settings={{this.tagEditorSettings}}
        @selectedTags={{this.tags}}
        @tagsLimit={{this.tagsLimitForEditor}}
        @onEndTagCreation={{action "endTagCreation"}}
        @onTagsAdded={{action "newTagsAdded"}}
      />
    {{/let}}
  </li>
{{/if}}
{{#if allowModification}}
  {{#if isPlaceholderEffectivelyVisible}}
    <li class="input-element tags-input-placeholder" {{action "startTagCreation"}}>
      {{editPlaceholder}}
    </li>
  {{/if}}
  <li
    class="tag-creator-trigger input-element {{if allowCreation "clickable" "disabled"}}"
    {{action "startTagCreation"}}
  >
    <OneIcon @icon="plus" />
    {{#if createTriggerTip}}
      <OneTooltip @title={{createTriggerTip}} />
    {{/if}}
  </li>
  {{#if isClearButtonEffectivelyVisible}}
    <RemoveIcon
      @tooltipText={{tt this "clearBtn"}}
      class="input-clear-trigger"
      @onClick={{action "clearInput"}}
    />
  {{/if}}
{{/if}}
{{#if moreTags.length}}
  <li class="tag-item tag-item-plaintext more-tag clickable">
    <div class="tag-label more-tag-text">
      {{moreTagsText}}
    </div>
    <OneTooltip class="tooltip-with-tags">
      <ul class="tags-input">
        {{#each moreTags as |tag|}}
          <li class="tag-item">
            {{#if tag.icon}}
              <OneIcon @icon={{tag.icon}} class="tag-icon" />
            {{/if}}
            {{!-- Using truncated-string component is not necessary here --}}
            <span class="tag-label">
              {{tag.label}}
            </span>
          </li>
        {{/each}}
      </ul>
    </OneTooltip>
  </li>
{{/if}}
{{yield}}
