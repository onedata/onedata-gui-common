{{#if hasCheckbox}}
  <OneCheckbox
    class="item-checkbox"
    @isReadOnly={{not _isCheckboxActive}}
    @checked={{_isSelected}}
    @update={{toggleSelection}}
  />
{{/if}}
{{#if (and isCollapsible (not disableToggleIcon))}}
  <OneIcon class="toggle-icon" @icon="arrow-down" />
{{/if}}
<span class="header-content-container">
  {{yield (hash
    toggleAction=(action "toggle")
  )}}
</span>
