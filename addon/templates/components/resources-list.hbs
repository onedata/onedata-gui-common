<OneCollapsibleList
  @hasCheckboxes={{isSelectable}}
  @allowOnlySingleSelection={{eq selectionMode "single"}}
  @selectionChanged={{action "selectionChanged"}}
  as |list|
>
  {{#if (or listHeader isSelectable)}}
    <list.header @title={{listHeader}} @isCollapsible={{false}} />
  {{/if}}
  {{#each sortedItems as |item|}}
    <list.item class="resource-item" @selectionValue={{item}} as |listItem|>
      <listItem.header
        @tagName={{if item.link "a" "div"}}
        @href={{item.link}}
        @isCollapsible={{false}}
        @toggleSelectionOnClick={{isSelectable}}
        class={{if isSelectable "clickable"}}
      >
        {{#if item.icon}}
          <span
            class={{concat-classes
              "item-icon-container"
              (if isResourceWithAdditionalInfo "icon-container popover-info-trigger")
            }}
            data-record-id={{item.record.entityId}}
            {{action
              (mut item.itemInfoOpened)
              (not item.itemInfoOpened)
              bubbles=false
            }}
            onmouseover={{action "itemInfoHovered" item true}}
            onmouseleave={{action "itemInfoHovered" item false}}
          >
            {{#if isResourceWithAdditionalInfo}}
              <FlippableIcons
                @iconName={{item.icon}}
                @iconColor={{iconColor}}
                @isHovered={{item.hasItemInfoHovered}}
                @suppressFlipping={{item.itemInfoOpened}}
              />
            {{else}}
              <OneIcon class="item-icon" @icon={{item.icon}} />
              <OneTooltip @placement="top" @triggerEvents="hover">
                {{#if item.conflictingLabelSource}}
                  <NameConflict @item={{item.conflictingLabelSource}} />
                {{else}}
                  {{item.label}}
                {{/if}}
              </OneTooltip>
            {{/if}}
          </span>
        {{/if}}
        <TruncatedString>
          <span
            class="one-label"
            onmouseover={{action "itemInfoHovered" item true}}
            onmouseleave={{action "itemInfoHovered" item false}}
          >
            {{#if item.conflictingLabelSource}}
              <NameConflict @item={{item.conflictingLabelSource}} />
            {{else}}
              {{item.label}}
            {{/if}}
          </span>
        </TruncatedString>
        {{#if item.actions.length}}
          <ActionsToolbar
            @isMinimized={{true}}
            @toolbarClasses=""
            @toolbarToggleClasses="btn-menu-toggle"
            @dropdownPlacement="auto"
            @actionsArray={{item.actions}}
          />
        {{/if}}
      </listItem.header>
      {{#if isResourceWithAdditionalInfo}}
        <RecordInfoPopover
          @isOpened={{item.itemInfoOpened}}
          @triggerSelector={{item.itemInfoTriggerSelector}}
        >
          {{component (concat item.record.constructor.modelName "-info-content")
            record=item.record
          }}
        </RecordInfoPopover>
      {{/if}}
    </list.item>
  {{/each}}
</OneCollapsibleList>
{{yield}}
