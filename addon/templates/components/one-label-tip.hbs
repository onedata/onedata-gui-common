<OneIcon @icon={{icon}}>
  {{#if hasBlock}}
    <OneTooltip
      class={{tooltipClassInternal}}
      @placement={{placement}}
      @triggerEvents={{triggerEvents}}
    >
      {{yield}}
    </OneTooltip>
  {{else}}
    <OneTooltip
      class={{tooltipClassInternal}}
      @title={{title}}
      @placement={{placement}}
      @triggerEvents={{triggerEvents}}
    />
  {{/if}}
</OneIcon>
