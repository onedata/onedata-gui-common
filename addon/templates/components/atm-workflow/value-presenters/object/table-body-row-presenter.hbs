{{yield (hash section="start")}}
{{#if columns.length}}
  {{#each columns as |column|}}
    <td class="column-object-property">
      <TruncatedString>
        {{evaluate-function stringifyObjectProperty column}}
      </TruncatedString>
    </td>
  {{/each}}
{{else}}
  <td class="column-value">
    <TruncatedString>
      <AtmWorkflow::ValuePresenters::Object::SingleLinePresenter @value={{value}} />
    </TruncatedString>
  </td>
{{/if}}
{{yield (hash section="end")}}
