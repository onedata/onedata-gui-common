<div class="header-container">
  <BsButtonGroup
    class="presenter-type-selector"
    @value={{presenterType}}
    @type="radio"
    @onChange={{action "presenterTypeChange"}}
    as |bg|
  >
    {{#each (array "visual" "raw") as |type|}}
      <bg.button
        class={{concat "presenter-type-" type}}
        disabled={{not isPresenterTypeToggleEnabled}}
        @type="default"
        @size="sm"
        @value={{type}}
      >
        {{tt this (concat "presenterTypes." type)}}
      </bg.button>
    {{/each}}
  </BsButtonGroup>
  <a class="copy-link clickable" onclick={{action "copyJson"}}>
    <OneIcon @icon="browser-copy" />
    {{tt this "copyJson"}}
  </a>
</div>

<PerfectScrollbarElement class="content-container">
  {{component currentPresenterComponent
    value=value
    dataSpec=dataSpec
    context=context
  }}
</PerfectScrollbarElement>
