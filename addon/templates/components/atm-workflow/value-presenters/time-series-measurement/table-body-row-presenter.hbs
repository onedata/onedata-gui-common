{{yield (hash section="start")}}
<td class="column-timestamp">
  <TruncatedString>
    {{date-format value.timestamp format="report" blank="—"}}
  </TruncatedString>
</td>
<td class="column-ts-name">
  <TruncatedString>{{value.tsName}}</TruncatedString>
</td>
<td class="column-value">
  <TruncatedString>{{value.value}}</TruncatedString>
</td>
{{yield (hash section="end")}}
