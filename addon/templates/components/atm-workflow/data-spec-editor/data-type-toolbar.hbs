{{#if canPackIntoArray}}
  <OneIcon
    onclick={{action "packIntoArray"}}
    @icon="collection"
    class={{concat-classes "pack-into-array" (if isEnabled "clickable")}}
  >
    {{#if isEnabled}}
      <OneTooltip @title={{tt this "actions.packIntoArray"}} />
    {{/if}}
  </OneIcon>
{{/if}}
{{#if canUnpackFromArray}}
  <OneIcon
    onclick={{action "unpackFromArray"}}
    @icon="flatten"
    class={{concat-classes "unpack-from-array" (if isEnabled "clickable")}}
  >
    {{#if isEnabled}}
      <OneTooltip @title={{tt this "actions.unpackFromArray"}} />
    {{/if}}
  </OneIcon>
{{/if}}
<OneIcon
  onclick={{action (if shouldWarnOnRemove "toggleRemoveWarn" "remove")}}
  @icon="close"
  class={{concat-classes "remove-trigger" (if isEnabled "clickable")}}
>
  {{#if isEnabled}}
    <OneTooltip @title={{tt this "actions.remove"}} />
  {{/if}}
</OneIcon>
<RenderLater @triggerRender={{isRemoveWarnOpened}}>
  <OneWebuiPopover
    @triggerSelector={{local-selector elementId ".remove-trigger"}}
    @open={{isRemoveWarnOpened}}
  >
    <ClickOutside
      @onClickOutside={{action "toggleRemoveWarn" false}}
      @exceptSelector={{local-selector elementId ".remove-trigger"}}
    >
      <p>{{tt this "removeWarn.content"}}</p>
      <div class="text-right">
        <OneButton
          @type="default"
          @size="sm"
          @onClick={{action "toggleRemoveWarn" false}}
        >
          {{tt this "removeWarn.no"}}
        </OneButton>
        {{!-- Using HTML "space" entity to preserve space between inline elements --}}
        &#32;
        <OneButton
          @type="danger"
          @size="sm"
          @onClick={{action "remove"}}
        >
          {{tt this "removeWarn.yes"}}
        </OneButton>
      </div>
    </ClickOutside>
  </OneWebuiPopover>
</RenderLater>
{{yield}}
