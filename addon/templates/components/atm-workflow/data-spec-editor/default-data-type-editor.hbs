<div class="data-type-header">
  <span class="data-type-name">{{dataTypeTranslation}}</span>
  {{#if (eq mode "edit")}}
    <AtmWorkflow::DataSpecEditor::DataTypeToolbar
      @dataSpecFilters={{dataSpecFilters}}
      @isEnabled={{isEnabled}}
      @editorElement={{editorElement}}
      @onElementChange={{onElementChange}}
    />
  {{/if}}
</div>
{{#if formRootGroup}}
  <TruncatedString>
    <a class="azure clickable form-summary-toggle" {{action "toggleFormVisibility"}}>
      <OneIcon
        class="form-summary-icon"
        @icon="settings"
      /><span class="form-summary">{{formSummary}}</span>
    </a>
  </TruncatedString>
  {{#if isFormVisible}}
    <hr />
    <FormComponent::FieldRenderer @field={{formRootGroup}} />
  {{/if}}
{{/if}}
{{yield}}
