<AtmWorkflow::ValueEditors::Commons::EditorBox
  @editorState={{editorState}}
  @onRemove={{onRemove}}
  as |editorBox|
>
  {{#if (eq editorBox.section "content")}}
    <form class="form form-horizontal form-component">
      <FormComponent::FieldRenderer @field={{formRootGroup}} />
    </form>
  {{/if}}
</AtmWorkflow::ValueEditors::Commons::EditorBox>
