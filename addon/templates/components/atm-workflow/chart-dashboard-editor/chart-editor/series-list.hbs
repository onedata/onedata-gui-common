{{#if (and (not editorContext.isReadOnly) (not hideActions))}}
  <div class="list-header">
    <OneButton
      class="add-series-btn"
      @type="primary"
      @size="sm"
      @onClick={{action "addSeries"}}
    >
      <OneIcon @icon="plus" />
      <span class="text">{{tt this "addSeries"}}</span>
    </OneButton>
  </div>
{{/if}}
<AtmWorkflow::ChartDashboardEditor::ChartEditor::ElementsList
  @itemModels={{itemModels}}
  @allowDragDrop={{not hideActions}}
  @hideActions={{hideActions}}
  @editorContext={{editorContext}}
/>
