{{#if (not editorContext.isReadOnly)}}
  <div class="list-header">
    <OneButton
      class="add-series-group-btn"
      @type="primary"
      @size="sm"
      @onClick={{action "addSeriesGroup"}}
    >
      <OneIcon @icon="plus" />
      <span class="text">{{tt this "addSeriesGroup"}}</span>
    </OneButton>
  </div>
{{/if}}
<AtmWorkflow::ChartDashboardEditor::ChartEditor::ElementsList @itemModels={{itemModels}} @allowDragDrop={{true}} @allowNesting={{true}} @editorContext={{editorContext}} />
