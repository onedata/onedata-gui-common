<PerfectScrollbarElement class="form-column">
  <AtmWorkflow::ChartDashboardEditor::ChartEditor::SeriesEditorForm
    @series={{chartElement}}
    @chart={{chart}}
    @editorContext={{editorContext}}
  />
</PerfectScrollbarElement>
<div class="details-column">
  <AtmWorkflow::ChartDashboardEditor::FunctionEditor
    @outputFunction={{chartElement.dataProvider}}
    @detachedFunctions={{chartElement.detachedFunctions}}
    @executionContext={{functionExecutionContext}}
    @editorContext={{editorContext}}
    @tip={{tt this "seriesFunctionEditorTip"}}
  />
</div>
