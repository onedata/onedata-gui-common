{{#if (not editorContext.isReadOnly)}}
  <div class="list-header">
    <OneButton
      class="add-axis-btn"

      @type="primary"
      @size="sm"
      @onClick={{action "addAxis"}}
    >
      <OneIcon @icon="plus" />
      <span class="text">{{tt this "addAxis"}}</span>
    </OneButton>
  </div>
{{/if}}
<AtmWorkflow::ChartDashboardEditor::ChartEditor::ElementsList
  @itemModels={{itemModels}}
  @allowDragDrop={{true}}
  @editorContext={{editorContext}}
/>
