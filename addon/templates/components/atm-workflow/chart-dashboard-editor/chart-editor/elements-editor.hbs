<h2>{{tt this "header"}}</h2>
<OneBsTab
  class="only-tab-bar bs-tab-onedata"
  @activeId={{selectedTab.id}}
  @fade={{false}}
  @customTabs={{true}}
  as |tab|
>
  <PerfectScrollbarElement @suppressScrollY={{true}}>
    <BsNav @type="tabs" as |nav|>
      {{#each tabs as |tabSpec|}}
        <nav.item @active={{eq selectedTab tabSpec}}>
          <a
            class={{concat-classes
              "nav-link element-editor-nav-link"
              (if (not-eq selectedTab tabSpec) "clickable")
            }}
            role="tab"
            onclick={{action "openTab" tabSpec}}
          >
            <OneIcon @icon={{tabSpec.icon}} />
            <TruncatedString>
              {{#if tabSpec.name}}
                {{#if tabSpec.element.repeatPerPrefixedTimeSeries}}
                  <em>{{tabSpec.name}}</em>
                {{else}}
                  {{tabSpec.name}}
                {{/if}}
              {{else}}
                <em>{{namePlaceholder}}</em>
              {{/if}}
            </TruncatedString>
            {{#if tabSpec.validationErrorsMessage}}
              <WarningIcon @tooltipText={{tabSpec.validationErrorsMessage}} />
            {{/if}}
            <OneIcon
              class="close-trigger clickable"
              @icon="close"
              onclick={{action "closeTab" tabSpec}}
            />
          </a>
        </nav.item>
      {{/each}}
    </BsNav>
  </PerfectScrollbarElement>
  <div class="tab-content">
    {{#if (not tabs.length)}}
      <div class="no-elements-info info-box">
        <h3 class="header">
          {{tt this (concat
            "noElements.header."
            (if editorContext.isReadOnly "view" "edit")
          )}}
        </h3>
        <p class="description">
          {{tt this (concat
            "noElements.description."
            (if editorContext.isReadOnly "view" "edit")
          )}}
        </p>
      </div>
    {{/if}}
    {{#each tabs as |tabSpec|}}
      <tab.pane class="element-editor-tab-pane" @id={{tabSpec.id}}>
        {{component
          (concat
            "atm-workflow/chart-dashboard-editor/chart-editor/"
            tabSpec.editorComponentName
          )
          chartElement=tabSpec.element
          chart=chart
          editorContext=editorContext
        }}
      </tab.pane>
    {{/each}}
  </div>
</OneBsTab>
