<OneDraggableObjectTarget
  class="workspace-drag-target"
  @action={{action "acceptDraggedFunction"}}
>
  <PerfectScrollbarElement @registerApi={{action "registerScrollbarApi"}}>
    <div class="functions-container">
      {{#if outputFunction}}
        <AtmWorkflow::ChartDashboardEditor::FunctionEditor::FunctionRenderer
          @chartFunction={{outputFunction}}
          @executionContext={{executionContext}}
          @editorContext={{editorContext}}
        />
      {{/if}}
      <div class="detached-functions-container">
        {{#each detachedFunctions as |detachedFunction|}}
          <AtmWorkflow::ChartDashboardEditor::FunctionEditor::FunctionRenderer
            @chartFunction={{detachedFunction}}
            @executionContext={{executionContext}}
            @editorContext={{editorContext}}
          />
        {{/each}}
      </div>
    </div>
  </PerfectScrollbarElement>
  {{#if tip}}
    <OneLabelTip class="function-editor-tooltip" @title={{tip}} />
  {{/if}}
</OneDraggableObjectTarget>
