<PerfectScrollbarElement class="dashboard-visualiser" @click={{action "workspaceClick"}}>
  <div class="dashboard-visualiser-info">
    <span class="one-label">{{tt this "preview"}}</span>
    <OneLabelTip @title={{tt this "previewTooltip"}} />
  </div>
  <AtmWorkflow::ChartDashboardEditor::SectionsEditor::Section
    @section={{rootSection}}
    @editorContext={{editorContext}}
  />
</PerfectScrollbarElement>
<AtmWorkflow::ChartDashboardEditor::SectionsEditor::Sidebar
  class="editor-sidebar"
  @selectedElement={{selectedElement}}
  @hasValidationErrors={{bool rootSection.validationErrors.length}}
  @editorContext={{editorContext}}
/>
