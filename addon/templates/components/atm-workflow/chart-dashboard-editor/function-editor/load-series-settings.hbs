<form onsubmit={{prevent-default}} class="form form-horizontal form-component">
  <FormComponent::FieldRenderer @field={{mainForm}} />
  <a
    class="clickable missing-points-collapse"
    onclick={{action (mut isReplaceEmptyFormVisible) (not isReplaceEmptyFormVisible)}}
  >
    {{tt this "missingPointsCollapse"}}
    <OneIcon @icon={{if isReplaceEmptyFormVisible "arrow-up" "arrow-down"}} />
  </a>
  {{#if isReplaceEmptyFormVisible}}
    <FormComponent::FieldRenderer @field={{replaceEmptyFuncForm}} />
  {{/if}}
</form>
