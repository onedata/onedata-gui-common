<form @onsubmit={{prevent-default}} class="form form-horizontal form-component">
  <FormComponent::FieldRenderer @field={{detailsForm}} />
</form>
<OneButton
  class="edit-content"
  @type="default"
  @size="sm"
  @onClick={{action "editContent"}}
>
  <OneIcon @icon={{if editorContext.isReadOnly "view" "browser-rename"}} />
  <span class="text">
    {{tt this (if editorContext.isReadOnly "viewContent" "editContent")}}
  </span>
</OneButton>
