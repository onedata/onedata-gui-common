{{#if isAcceptingInsideDrag}}
  <OneDraggableObjectTarget
    class="inside-drag-target"
    @action={{action "acceptDraggedElement" "inside"}}
  />
{{/if}}

{{#if (or section.title section.titleTip isChartNavigationShared)}}
  <div class="section-header">
    {{#if section.title}}
      <h3 class="section-title">
        <TruncatedString>{{section.title}}</TruncatedString>
      </h3>
    {{/if}}
    {{#if section.titleTip}}
      <OneLabelTip class="section-title-tip" @tooltipClass="tooltip-lg">
        {{section.titleTip}}
      </OneLabelTip>
    {{/if}}
    {{#if isChartNavigationShared}}
      <OneTimeSeriesChart::Toolbar class="section-charts-shared-navigation" />
    {{/if}}
  </div>
{{/if}}

{{#if section.description}}
  <p class="section-description">{{section.description}}</p>
{{/if}}

{{#if section.charts.length}}
  <div class="section-charts">
    {{#each section.charts as |chart|}}
      <AtmWorkflow::ChartDashboardEditor::SectionsEditor::Chart
        @chart={{chart}}
        @editorContext={{editorContext}}
      />
    {{/each}}
  </div>
{{/if}}

{{#if (not editorContext.isReadOnly)}}
  <div
    class="large-trigger add-chart clickable"
    onclick={{action "addChart"}}
  >
    <span class="content">
      <OneIcon @icon="plus" />
      {{tt this "addChart"}}
    </span>
  </div>
{{/if}}

{{#if section.sections.length}}
  <div class="section-subsections">
    {{#each section.sections as |subsection|}}
      <AtmWorkflow::ChartDashboardEditor::SectionsEditor::Section
        @section={{subsection}}
        @editorContext={{editorContext}}
      />
    {{/each}}
  </div>
{{/if}}

{{#if (not editorContext.isReadOnly)}}
  <div
    class="large-trigger add-subsection clickable"
    onclick={{action "addSubsection"}}
  >
    <span class="content">
      <OneIcon @icon="plus" />
      {{tt this "addSubsection"}}
    </span>
  </div>
{{/if}}

{{#if (not section.isRoot)}}
  <AtmWorkflow::ChartDashboardEditor::SectionsEditor::FloatingToolbar
    @model={{section}}
    @editorContext={{editorContext}}
  />
{{/if}}

{{#if isAcceptingEdgeDrag}}
  <OneDraggableObjectTarget
    class="before-drag-target"
    @action={{action "acceptDraggedElement" "before"}}
  />

  <OneDraggableObjectTarget
    class="after-drag-target"
    @action={{action "acceptDraggedElement" "after"}}
  />
{{/if}}
