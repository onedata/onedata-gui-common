<div class="drop-title-bar">
  <TruncatedString class="provider-label">
    <span class="hidden-xs">
      <OneIcon @icon="provider" class="state-indicator">
        <OneTooltip @title={{tt this (if this.provider.online "online" "offline")}} />
      </OneIcon>
      <TruncatedString><NameConflict
        @item={{this.provider}}
        @tagName="span"
      /></TruncatedString>
    </span>
    <span class="hidden-sm hidden-md hidden-lg">{{tt this "status"}}</span>
  </TruncatedString>
  <div class="provider-label-secondary hidden-sm hidden-md hidden-lg">
    {{tt this (if this.provider.online "online" "offline")}}
  </div>
</div>
<div class="drop-provider-host-container">
  <input
    class={{concat-classes
      "provider-host-text"
      "truncate"
      (concat "host-input-" (model-routable-id this.provider.id))
    }}
    value={{this.provider.host}}
    readonly
  >
  <div class="provider-host-copy-btn-container">
    <CopyButton
      @clipboardTarget={{concat ".host-input-" (model-routable-id this.provider.id)}}
      @success={{action "copySuccess"}}
      @error={{action "copyError"}}
      class="provider-host-copy-btn clickable"
    >
      <OneIcon @icon="browser-copy" />
    </CopyButton>
  </div>
</div>
<div class="drop-body">
  {{!-- TODO: location name - get it from Google Maps API --}}
  {{!-- <div class="provider-location">
    {{provider.location}}
  </div> --}}
  <div class="loadable-row sm spaces-list">
    <PerfectScrollbarElement class="full-height relative space-list-scroll-container">
      <PromiseProxyContainer
        @proxy={{this.listProxy}}
        @loadingLabel={{this.spaceListLoadingLabel}}
        @sizeClass="sm"
      >
        <ul class="spaces-items">
          <li class="table-start-row"></li>
          <li class="first-row" style={{this.infiniteScroll.firstRowModel.style}}></li>
          {{#each this.spacesSorted as |space|}}
            <ProviderPlace::Drop::Space
              @space={{space}}
              @provider={{this.provider}}
              @providerVersion={{this.providerVersion}}
            />
          {{/each}}
        </ul>
      </PromiseProxyContainer>
    </PerfectScrollbarElement>
  </div>
  <hr>
  <div class="btn-container">
    <div class="row row-btn">
      {{#if this.isVisitProviderButtonShown}}
        {{#if this.provider.online}}
          <a href={{this.visitProviderUrl}} class="btn btn-sm btn-go-to-files btn-primary">
            <OneIcon @icon="provider" />
            <span class="text">
              {{tt this "goToFiles"}}
            </span>
          </a>
        {{else}}
          <div class="btn btn-danger no-pointer-events offline-badge">
            {{tt this "offline"}}
          </div>
        {{/if}}
      {{/if}}
    </div>
  </div>
</div>
