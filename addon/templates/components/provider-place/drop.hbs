<div class="drop-title-bar">
  <TruncatedString class="provider-label">
    <span class="hidden-xs">
      <OneIcon @icon="provider" class="state-indicator">
        <OneTooltip @title={{tt this (if provider.online "online" "offline")}} />
      </OneIcon>
      <TruncatedString><NameConflict
        @item={{provider}}
        @tagName="span"
      /></TruncatedString>
    </span>
    <span class="hidden-sm hidden-md hidden-lg">{{tt this "status"}}</span>
  </TruncatedString>
  <div class="provider-label-secondary hidden-sm hidden-md hidden-lg">
    {{#if provider.online}}
      {{tt this "online"}}
    {{else}}
      {{tt this "offline"}}
    {{/if}}
  </div>
</div>
<div class="drop-provider-host-container">
  <input class="provider-host-text truncate {{concat "host-input-" (model-routable-id provider.id)}}" value={{provider.host}} readonly>
  <div class="provider-host-copy-btn-container">
    <CopyButton
      @clipboardTarget={{concat ".host-input-" (model-routable-id provider.id)}}
      @success={{action "copySuccess"}}
      @error={{action "copyError"}}
      class="provider-host-copy-btn clickable"
    >
      <OneIcon @icon="browser-copy" />
    </CopyButton>
  </div>
</div>
<div class="drop-body">
  {{!-- TODO: location name - get it from Google Maps API --}}
  {{!-- <div class="provider-location">
    {{provider.location}}
  </div> --}}
  <div class="loadable-row sm spaces-list">
    <PerfectScrollbarElement class="full-height relative">
      <LoadingContainer
        @isLoading={{_spacesLoading}}
        @sizeClass="sm"
        @errorReason={{_spaceListError}}
      >
        <ul class="spaces-items">
          {{#each _spacesSorted as |space|}}
            <ProviderPlace::Drop::Space
              @space={{space}}
              @provider={{provider}}
              @providerVersion={{providerVersion}}
            />
          {{/each}}
        </ul>
      </LoadingContainer>
    </PerfectScrollbarElement>
  </div>
  <hr>
  <div class="btn-container">
    <div class="row row-btn">
      {{#if provider.online}}
       <PromiseProxyContainer @proxy={{_spaceListProxy}} @sizeClass="xs">
          <a href={{visitProviderUrl}} class="btn btn-sm btn-go-to-files btn-primary">
            <OneIcon @icon="provider" />
            <span class="text">
              {{tt this "goToFiles"}}
            </span>
          </a>
        </PromiseProxyContainer>
      {{else}}
        <div class="btn btn-danger no-pointer-events offline-badge">
          {{tt this "offline"}}
        </div>
      {{/if}}
    </div>
  </div>
</div>
