<OneTile
  @title={{title}}
  class="providers-map-tile"
  @moreText={{moreText}}
  @aspect={{aspect}}
  @customLink={{customLink}}
  @isScalable={{true}}
>
  <PromiseProxyContainer @proxy={{providersProxy}}>
    <div class="map-container">
      <OneAtlas class="providers-map" as |atlas|>
        {{#each providersProxy as |provider|}}
          <atlas.position
            @latitude={{or provider.latitude provider.geoLatitude 0}}
            @longitude={{or provider.longitude provider.geoLongitude 0}}
            as |position|
          >
            <position.point>
              <ProviderPlace
                @provider={{provider}}
                @atlasWidth={{atlas.width}}
                @circleSizeScale={{4}}
                @circleColor={{get providersColors (model-routable-id provider)}}
                @renderDrop={{false}}
              />
            </position.point>
          </atlas.position>
        {{/each}}
      </OneAtlas>
    </div>
  </PromiseProxyContainer>
</OneTile>
