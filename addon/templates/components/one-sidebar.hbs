<div class="container-fluid">
  <div class="row-heading row">
    <div class="col-title">{{title}}</div>
    {{#if isPrevSpinnerShown}}
      <div class="sidebar-header-loader">
        <SpinSpinnerBlock
          @sizeClass="xs"
          class="absolute-middle-centered"
        />
      </div>
    {{/if}}
    <OneSidebarToolbar @buttons={{buttons}} />
  </div>
  <div class="row-body row">
    <div class="two-level-sidebar">
      {{#if isCollectionEmpty}}
        <EmptyCollectionSidebar
          @resourceType={{resourceType}}
          @showGetStarted={{showGetStartedWhenEmpty}}
        />
      {{else if isFilteringEnabled}}
        <div class="sidebar-filters-container">
          <div class="form-group form-group-sm form-group-light search-bar-form-group">
            <div class="input-group with-icon-addon">
              <SearchBar
                class="form-control"
                @search={{action "setFilter"}}
                placeholder={{searchPlaceholder}}
              />
              <div class="input-group-addon">
                <OneIcon @icon="search" />
              </div>
            </div>
          </div>
          {{#if advancedFiltersComponent}}
            <a class="toggle-more-filters clickable" {{action "toggleAdvancedFilters"}}>
              {{#if areAdvancedFiltersVisible}}
                {{tt this "hideAdvancedFilters"}}
                <OneIcon class="arrow-icon" @icon="arrow-up" />
              {{else}}
                {{tt this "showAdvancedFilters"}}
                <OneIcon class="arrow-icon" @icon="arrow-down" />
              {{/if}}
            </a>
            <OneCollapse
              class="advanced-filters-collapse"
              @collapsed={{not areAdvancedFiltersVisible}}
            >
              {{#let (component advancedFiltersComponent) as |advancedFiltersComponent|}}
                <advancedFiltersComponent
                  @collection={{this.sortedCollection}}
                  @onChange={{action "setAdvancedFilter"}}
                />
              {{/let}}
            </OneCollapse>
          {{/if}}
        </div>
      {{/if}}
      <ul class="one-list one-sidebar-primary-item-list">
        {{#if isInfiniteScroll}}
          <li class="table-start-row"></li>
          <li class="first-row" style={{infiniteScroll.firstRowModel.style}}></li>
        {{/if}}
        {{#each filteredCollection as |item|}}
          {{#let (model-routable-id item) as |routableId|}}
            <li
              class={{concat-classes
                "one-list-item clickable resource-item data-row"
                (if (eq primaryItem item) "active")
              }}
              data-row-id={{item.entityId}}
            >
              <OneSidebar::LinkTo
                @route={{if routableId "onedata.sidebar.content.index" "onedata.sidebar"}}
                @models={{if routableId
                  (array sidebarType (model-routable-id item))
                  (array sidebarType)
                }}
                class="item-header"
              >
                {{#if firstLevelItemComponent}}
                  {{component firstLevelItemComponent
                    item=item
                    inSidenav=inSidenav
                    sidebar=this
                  }}
                {{else}}
                  {{#if firstLevelItemIcon}}
                    <OneIcon class="sidebar-item-icon" @icon={{firstLevelItemIcon}} />
                  {{/if}}
                  <TruncatedString>
                    <NameConflict @item={{item}} @tagName="span" class="one-label" />
                  </TruncatedString>
                {{/if}}
              </OneSidebar::LinkTo>
              {{#if (eq primaryItem item)}}
                <ul class="one-list one-list-level-2">
                  {{component secondLevelItemsComponent
                    item=item
                    secondaryItemId=secondaryItemId
                    sidebar=this
                    secondLevelItems=secondLevelItems
                    sidebarType=sidebarType
                  }}
                </ul>
              {{/if}}
            </li>
          {{/let}}
        {{/each}}
      </ul>
      {{#if isNextSpinnerShown}}
        <div class="loading-row loading-row-next">
          <SpinSpinnerBlock
            @sizeClass={{infiniteScrollSpinnerSize}}
            class="absolute-middle-centered"
          />
        </div>
      {{/if}}
    </div>
  </div>
</div>
