<BsButton
  class={{concat-classes
    class
    "one-button"
    (if isInPendingState "pending")
    (if (not isEffDisabled) "clickable")
  }}
  disabled={{isEffDisabled}}
  @size={{size}}
  @type={{type}}
  @bubble={{bubble}}
  @buttonType={{buttonType}}
  @onClick={{clickHandler}}
  ...attributes
>
  {{#if isSpinnerVisible}}<span class="spinner-container">{{spin-spinner}}</span> {{/if}}{{yield}}
</BsButton>
