<BsModal
  @fade={{@fade}}
  @open={{bool @open}}
  @backdrop={{@backdrop}}
  @keyboard={{@keyboard}}
  @scrollable={{@scrollable}}
  @backdropClose={{@backdropClose}}
  @renderInPlace={{@renderInPlace}}
  @transitionDuration={{this.transitionDuration}}
  @backdropTransitionDuration={{this.backdropTransitionDuration}}
  @onHide={{this.hide}}
  @onSubmit={{@onSubmit}}
  @onShow={{this.show}}
  @onShown={{@onShown}}
  @onHidden={{@onHidden}}
  @size={{@size}}
  @bodyComponent={{component "one-modal/body"}}
  class={{@modalClass}}
  id={{this.modalId}}
  as |modal|
>
  {{yield modal}}
</BsModal>