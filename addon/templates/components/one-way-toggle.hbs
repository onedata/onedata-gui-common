<input type="checkbox" id={{inputId}} disabled={{or isReadOnly _isInProgress}}>
<div class="one-way-toggle-elements-container tooltip-container">
  <div class="one-way-toggle-control">
    <div class="one-way-toggle-track"></div>
    <div class="one-way-toggle-thumb">
      {{#if icon}}
        <OneIcon class="thumb-icon" @icon={{icon}} />
      {{/if}}
    </div>
  </div>
  {{#if (and isReadOnly showLockForReadOnly)}}
    <div class="one-way-toggle-readonly-icon">
      <OneIcon @icon="lock" />
    </div>
  {{/if}}
  {{#if _isInProgress}}
    <SpinSpinnerBlock class="one-way-toggle-spinner" @sizeClass="xxs" />
  {{/if}}
  {{#if effectiveTip}}
    <OneTooltip @title={{effectiveTip}} @placement="top" @triggerEvents="hover" />
  {{/if}}
</div>

