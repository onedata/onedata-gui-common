<a
  class={{concat-classes "nav-link" (if isActive "active")}}
  onclick={{action "anchorClicked"}}
>
  <TruncatedString>
    {{#if item.icon}}
      <div class="inline-icon-container">
        <OneIcon @icon={{item.icon}} />
      </div>
    {{/if}}
    <span class="tab-name">{{item.name}}</span>
  </TruncatedString>
</a>