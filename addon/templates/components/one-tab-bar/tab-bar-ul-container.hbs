<OneTabBar::TabBarUlArrow
  @direction="left"
  @moveTabs={{action "moveTabs"}}
  @disabled={{scrollLeftReached}}
/>
<div class="container-inner-scroll-content">
  {{yield (hash tabBarUlStyle=tabBarUlStyle)}}
</div>
<OneTabBar::TabBarUlArrow
  @direction="right"
  @moveTabs={{action "moveTabs"}}
  @disabled={{scrollRightReached}}
/>
