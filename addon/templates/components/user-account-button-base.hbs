{{#if mobileMode}}
  <OneCollapsibleList as |list|>
    <list.item
      class="user-account-button"
      closeEventName="side-menu:close" as |listItem|
    >
      <listItem.header
        class={{concat-classes menuItemClasses (if isActive "active")}}
      >
        <OneIcon
          class="user-profile-icon item-icon"
          @icon="user-profile"
        /><span class="one-label user-account-button-username">{{username}}</span>
      </listItem.header>
      <listItem.content>
        <OneCollapsibleList as |list|>
          {{#if guiUtils.manageAccountText}}
            <list.item @isCollapsible={{false}} as |listItem|>
              <listItem.header
                onclick={{action "manageAccount"}}
                class={{concat-classes menuItemClasses "manage-account-action"}}
              >
                {{#if guiUtils.manageAccountExternalLink}}
                  <a href={{guiUtils.manageAccountExternalLink}}>
                    {{guiUtils.manageAccountText}}
                  </a>
                {{else}}
                  <LinkTo @route="onedata.sidebar" @model="users">
                    {{guiUtils.manageAccountText}}
                  </LinkTo>
                {{/if}}
              </listItem.header>
            </list.item>
          {{/if}}
          {{#if guiMessageManager.privacyPolicyUrl}}
            <list.item @isCollapsible={{false}} as |listItem|>
              <listItem.header
                onclick={{action "privacyPolicy"}}
                class={{concat-classes menuItemClasses "privacy-policy-action"}}
              >
                <a href={{guiMessageManager.privacyPolicyUrl}}>
                  {{tt this "privacyPolicy"}}
                </a>
              </listItem.header>
            </list.item>
          {{/if}}
          {{#if guiMessageManager.termsOfUseUrl}}
            <list.item @isCollapsible={{false}} as |listItem|>
              <listItem.header
                onclick={{action "termsOfUse"}}
                class={{concat-classes menuItemClasses "terms-of-use-action"}}
              >
                <a href={{guiMessageManager.termsOfUseUrl}}>
                  {{tt this "termsOfUse"}}
                </a>
              </listItem.header>
            </list.item>
          {{/if}}
          <list.item @isCollapsible={{false}} as |listItem|>
            <listItem.header
              onclick={{action "logout"}}
              class={{concat-classes menuItemClasses "logout-action"}}
            >
              {{tt this "logout"}}
            </listItem.header>
          </list.item>
        </OneCollapsibleList>
      </listItem.content>
    </list.item>
  </OneCollapsibleList>
{{else}}
  <div
    class={{concat-classes menuItemClasses (if isActive "active")}}
    onclick={{action "toggleMenu" bubbles=false}}
  >
    <div class="item-header truncate">
      <OneIcon @class="user-profile-icon item-icon" @icon="user-profile" />
      <span class="one-label user-account-button-username">
        {{username}}
      </span>
      <OneIcon class="user-toggle-icon" @icon={{if menuOpen "arrow-down" "arrow-up"}} />
    </div>
  </div>

  <OneWebuiPopover
    class="user-account-menu"
    @placement="top-left"
    @open={{menuOpen}}
    @padding={{false}}
    @triggerSelector={{menuTriggerSelector}}
    @popoverStyle="user-account"
    @multi={{true}} as |popover|
  >
    <ul class="dropdown-menu">
      {{#if guiUtils.manageAccountText}}
        <li>
          {{#if guiUtils.manageAccountExternalLink}}
            <a
              href={{guiUtils.manageAccountExternalLink}}
              class="manage-account-action clickable"
              onclick={{action "manageAccount"}}
            >
              {{guiUtils.manageAccountText}}
            </a>
          {{else}}
            <LinkTo
              @route="onedata.sidebar"
              @model="users"
              class="manage-account-action clickable"
              onclick={{action "manageAccount"}}
            >
              {{guiUtils.manageAccountText}}
            </LinkTo>
          {{/if}}
        </li>
      {{/if}}
      {{#if guiMessageManager.privacyPolicyUrl}}
        <li>
          <a
            href={{guiMessageManager.privacyPolicyUrl}}
            class="clickable"
            onclick={{action "privacyPolicy"}}
          >
            {{tt this "privacyPolicy"}}
          </a>
        </li>
      {{/if}}
      {{#if guiMessageManager.termsOfUseUrl}}
        <li>
          <a
            href={{guiMessageManager.termsOfUseUrl}}
            class="clickable"
            onclick={{action "termsOfUse"}}
          >
            {{tt this "termsOfUse"}}
          </a>
        </li>
      {{/if}}
      <li>
        <a class="clickable" {{action "logout"}}>
          {{tt this "logout"}}
        </a>
      </li>
    </ul>
  </OneWebuiPopover>
{{/if}}
