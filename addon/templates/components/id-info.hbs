<OneIcon
  id={{popoverTriggerId}}
  @icon="circle-id"
  class="icon-trigger id-trigger clickable"
/>
<OneWebuiPopover
  class="id-info"
  @popoverStyle="id-info"
  @triggerSelector={{concat "#" popoverTriggerId}}
  as |popover|
>
  <div class="form-group without-margin">
    <label class="control-label">{{idLabel}}:</label>
    <OneClipboardLine
      @size="sm"
      @value={{idValue}}
      @showText={{false}}
      @btnType="default"
    />
  </div>
</OneWebuiPopover>
