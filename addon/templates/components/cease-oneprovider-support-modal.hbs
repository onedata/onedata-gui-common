<OneModal
  @modalClass="cease-oneprovider-support-modal"
  @open={{opened}}
  @onHidden={{close}}
  as |modal|
>
  <modal.header>
    <h1>
      <OneIcon @icon="sign-warning-rounded" />
      <span class="one-label">{{tt this "headerText"}}</span>
    </h1>
  </modal.header>
  <modal.body>
    <p>{{tt this "mainDescription"}}</p>
    <ul class="info info-condensed info-gray">
      <li>
        {{tt this "firstWayDescription"}}
        <a
          class="clickable"
          href={{removeSpaceUrl}}
          {{action (or removeSpaceClick no-action) preventDefault=false}}
        >
          {{tt this "firstWayLink"}}
        </a>
      </li>
      <li>{{tt this "secondWayDescription"}}</li>
    </ul>
    <p>{{tt this "planDescription"}}</p>
  </modal.body>
  <modal.footer class="btn-toolbar">
    <OneButton @onClick={{close}}>
      {{tt this "close"}}
    </OneButton>
  </modal.footer>
</OneModal>
