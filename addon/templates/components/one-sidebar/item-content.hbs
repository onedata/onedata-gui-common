{{#if item.icon}}
  <OneIcon class={{iconClass}} @icon={{item.icon}} />
{{/if}}
<span class="one-label sidebar-item-title">{{item.label}}</span>
{{#if item.warningMessage}}
  <img
    class="warning-icon {{item.id}}-warning-icon"
    src={{root-url "assets/images/sign-warning-large.svg"}}
  >
  {{#unless (media "isMobile")}}
    <OneTooltip
      @title={{item.warningMessage}}
      @triggerElement={{concat ".item-" (or item.itemClassId item.id) " .warning-icon"}}
      @triggerEvent="hover"
    />
  {{/unless}}
{{/if}}
{{#if item.forbidden}}
  <OneIcon class="forbidden-icon one-icon-internal" @icon="no-view" />
{{/if}}
