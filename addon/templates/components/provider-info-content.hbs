<h1>
  <span class="one-label">
    {{tt this "title"}}
  </span>
</h1>
<table class="table table-condensed table-info">
  <tbody>
    <tr class="row-with-text">
      <td class="property-name">{{tt this "name"}}</td>
      <td class="property-value">
        <OneClipboardLine
          @size="sm"
          @value={{record.name}}
          @rawValue={{record.name}}
          @type="text"
        />
      </td>
    </tr>
    {{#if record.domain}}
      <tr class="row-with-text">
        <td class="property-name">{{tt this "domain"}}</td>
        <td class="property-value">
          <OneClipboardLine
            @size="sm"
            @value={{record.domain}}
            @rawValue={{record.domain}}
            @type="text"
          />
        </td>
      </tr>
    {{/if}}
    <tr class="row-with-text">
      <td class="property-name">{{tt this "id"}}</td>
      <td class="property-value id">
        <OneClipboardLine
          @size="sm"
          @value={{record.entityId}}
          @rawValue={{record.entityId}}
          @type="text"
        />
      </td>
    </tr>
    {{#if this.record.releaseVersion}}
      <tr class="row-with-text">
        <td class="property-name">{{tt this "version"}}</td>
        <td class="property-value">
          <span class="provider-release-version">{{this.record.releaseVersion}}</span>
          {{#if this.record.buildVersion}}
            <span class="provider-build-version">
              {{tt this "build" buildVersion=this.record.buildVersion}}
            </span>
          {{/if}}
        </td>
      </tr>
    {{/if}}
  </tbody>
</table>