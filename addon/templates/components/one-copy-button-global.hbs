{{#if (not-eq clipboardText undefined)}}
  <OneCopyButton
    @clipboardText={{clipboardText}}
    @textType={{textType}}
    {{!-- NOTE: OneCopyButton uses @class= --}} {{!-- formatter ignore --}}
    @class="hidden btn-global-copy-button" {{!-- formatter ignore --}}
    @notify={{action "copyEnded"}}
  />
{{/if}}
