{{yield}}{{#unless isTooltipDisabled}}<RenderLater @triggerRender={{showTooltip}} as |renderLater|><OneTooltip
  class={{tooltipClass}}
  @autoPlacement={{true}}
  @placement={{tooltipPlacement}}
  @title={{or customTooltipText tooltipText}}
  @triggerEvents=""
  @visible={{showTooltip}}
  @onHidden={{renderLater.resetRenderTrigger}}
  @onShown={{action "handleTooltipShown"}}
/></RenderLater>{{/unless}}
