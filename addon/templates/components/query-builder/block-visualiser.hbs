{{#component (concat "query-builder/" queryBlock.renderer)
  class=(concat "block-level-" level)
  operators=operators
  queryBlock=queryBlock
  queryProperties=queryProperties
  valuesBuilder=valuesBuilder
  level=level
  isReadOnly=isReadOnly
  popoverPlacement=popoverPlacement
  onConditionEditionStart=onConditionEditionStart
  onConditionEditionEnd=onConditionEditionEnd
  onConditionEditionValidityChange=onConditionEditionValidityChange
  onBlockRemoved=onBlockRemoved
  refreshQueryProperties=(action refreshQueryProperties)
}}
  {{#unless isReadOnly}}
    <button
      class="block-button remove-block clickable"
      onclick={{onBlockRemove}}
      onmouseenter={{action "removeButtonHover" true}}
      onmouseleave={{action "removeButtonHover" false}}
    >
      <OneIcon @icon="x" />
    </button>
    <QueryBuilder::BlockSettings
      @queryBlock={{queryBlock}}
      @operators={{operators}}
      @parentQueryBlock={{parentQueryBlock}}
      @open={{areSettingsVisible}}
      @triggerSelector={{concat "#" elementId}}
      @popoverPlacement={{popoverPlacement}}
      @onBlockReplace={{onBlockReplace}}
      @onSettingsClose={{action "onSettingsClose"}}
    />
  {{/unless}}
{{/component}}