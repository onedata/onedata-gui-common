<OneDraggableObject
  @content={{this.task}}
  @dragHandle=".task-drag-handle"
  @isDraggable={{eq this.mode "edit"}}
  class="draggable-task"
  @click={{action "headerClick"}}
>
  <div class="task-drag-handle"><RecordIcon @modelName="atmLambda" /></div>
  {{#if (eq mode "edit")}}
    <OneInlineEditor
      class="task-name"
      @value={{this.name}}
      @hideViewIcons={{true}}
      @onSave={{action "changeName"}}
    />
    {{#if this.task.validationErrors.length}}
      <div class="validation-error-indicator">
        <img
          class="warning-icon"
          src={{root-url "assets/images/sign-warning-large.svg"}}
        />
        <OneTooltip
          @triggerElement={{local-selector elementId ".warning-icon"}}
          @title={{this.task.validationErrors.[0].errorMessage}}
        />
      </div>
    {{/if}}
    <OneIcon
      @icon="settings-circle-filled"
      class={{concat-classes
        "task-actions-trigger clickable"
        (concat "actions-trigger-" elementId)
        (if areActionsOpened "active")
      }}
      onclick={{action "toggleActionsOpen" (not this.areActionsOpened)}}
    />
    <RenderLater @triggerRender={{this.areActionsOpened}}>
      <OneWebuiPopover
        class="task-actions"
        @padding={{false}}
        @popoverStyle="with-dropdown"
        @triggerSelector={{concat ".actions-trigger-" this.elementId}}
        @open={{this.areActionsOpened}}
        @onToggle={{action "toggleActionsOpen"}}
        as |popover|
      >
        <ClickOutside
          @onClickOutside={{action "toggleActionsOpen" false}}
          @exceptSelector={{concat ".actions-trigger-" this.elementId}}
        >
          <ActionsPopoverContent
            @actionsArray={{this.editTaskActions}}
            @actionClicked={{action (mut this.areActionsOpened) false}}
          />
        </ClickOutside>
      </OneWebuiPopover>
    </RenderLater>
  {{else}}
    <TruncatedString
      id={{this.taskNameElementId}}
      class="task-name"
    >
      {{this.name}}
    </TruncatedString>
  {{/if}}
</OneDraggableObject>
{{#if (eq mode "view")}}
  <OneCollapse class="task-details-collapse" @collapsed={{not this.areDetailsExpanded}}>
    <div class="task-details">
      <div class="detail-entries">
        {{#if this.task.instanceId}}
          <div class="detail-entry instance-id-detail">
            <div class="detail-label">{{tt this "details.instanceId"}}:</div>
            <div class="detail-value">
              <TruncatedString>{{this.task.instanceId}}</TruncatedString>
              <OneIcon
                @icon={{this.copyInstanceIdAction.icon}}
                class={{this.copyInstanceIdAction.className}}
                onclick={{this.copyInstanceIdAction.executeCallback}}
              />
            </div>
          </div>
        {{/if}}
        <div class="detail-entry status-detail">
          <div class="detail-label">{{tt this "details.status"}}:</div>
          <div class="detail-value">{{this.statusTranslation}}</div>
        </div>
        <div class="detail-entry items-in-processing-detail">
          <div class="detail-label">{{tt this "details.itemsInProcessing"}}:</div>
          <div class="detail-value">{{format-number this.itemsInProcessing}}</div>
        </div>
        <div class="detail-entry items-processed-detail">
          <div class="detail-label">{{tt this "details.itemsProcessed"}}:</div>
          <div class="detail-value">{{format-number this.itemsProcessed}}</div>
        </div>
        <div class="detail-entry items-failed-detail">
          <div class="detail-label">{{tt this "details.itemsFailed"}}:</div>
          <div class="detail-value">{{format-number this.itemsFailed}}</div>
        </div>
        {{#if this.viewTaskActions.length}}
          <div class="detail-entry actions-detail">
            {{#each this.viewTaskActions as |taskAction idx|}}
              <a
                class="clickable {{taskAction.className}}"
                {{action taskAction.executeCallback}}
              >
                {{taskAction.title}}
              </a>
              {{#if (lt idx (sub this.viewTaskActions.length 1))}}|{{/if}}
            {{/each}}
          </div>
        {{/if}}
      </div>
    </div>
  </OneCollapse>
{{/if}}
{{yield}}
