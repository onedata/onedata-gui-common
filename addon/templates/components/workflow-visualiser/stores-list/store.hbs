<TruncatedString class="store-name">
  <OneIcon @icon={{store.icon}} />{{store.name}}
</TruncatedString>
{{#if (and (eq mode "edit") isRemovingAllowed)}}
  <OneIcon
    @icon="close"
    class={{concat-classes "tag-remove clickable" removeAction.className}}
    onclick={{removeAction.executeCallback}}
  />
{{/if}}
{{yield}}
